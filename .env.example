# ===================================================================
# CONFIGURAÇÕES DO BANCO DE DADOS
# ===================================================================

# Host do banco PostgreSQL
DB_HOST=localhost

# Porta do banco PostgreSQL
DB_PORT=5432

# Nome do banco de dados
DB_NAME=receita_federal

# Usuário do banco
DB_USER=postgres

# Senha do banco
DB_PASSWORD=sua_senha_aqui

# Modo SSL para conexão com o banco (disable, allow, prefer, require)
# Use 'disable' para desenvolvimento local/docker, 'require' para produção
DB_SSL_MODE=prefer

# ===================================================================
# CONFIGURAÇÕES OPCIONAIS
# ===================================================================

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Tamanho do chunk para processamento
CHUNK_SIZE=10000

# Timeout para operações (em segundos)
TIMEOUT=3600

# ===================================================================
# CONFIGURAÇÕES DE PERFORMANCE
# ===================================================================

# Memória de trabalho para PostgreSQL
WORK_MEM=1GB

# Memória de manutenção
MAINTENANCE_WORK_MEM=2GB

# Número de workers para processamento paralelo
MAX_WORKERS=4

# ===================================================================
# CONFIGURAÇÕES DE REDE
# ===================================================================

# Timeout para download de arquivos (em segundos)
DOWNLOAD_TIMEOUT=600

# Número de tentativas para download
MAX_RETRIES=3

# ===================================================================
# CONFIGURAÇÕES DE ARMAZENAMENTO
# ===================================================================

# Diretório para arquivos temporários
TEMP_DIR=./temp

# Diretório para downloads (var legada — o ETL usa OUTPUT_FILES_PATH, abaixo)
DOWNLOAD_DIR=./downloads

# Diretório para logs
LOG_DIR=./logs

# Tablespace onde a staging (receita_federal_staging) será criada. Deixe vazio para
# usar o disco principal (pg_default). Para hospedar a staging em um volume separado,
# crie o tablespace no volume e informe o nome aqui, ex.: STAGING_TABLESPACE=staging
# (ver docs/atualizacao-base-receita.md). Combine com run_prod.py --relocate-to-main
# para trazer o banco promovido de volta ao disco principal após o switch.
STAGING_TABLESPACE=

# CAMINHOS OBRIGATÓRIOS PARA O ETL (downloads e extração)
# Em produção, aponte para um disco/volume separado do banco principal para não
# encher o disco raiz durante a carga, ex.:
#   OUTPUT_FILES_PATH=/mnt/pg_staging/etl/downloads
#   EXTRACTED_FILES_PATH=/mnt/pg_staging/etl/extracted
# (ver docs/atualizacao-base-receita.md)
OUTPUT_FILES_PATH=./dados/downloads
EXTRACTED_FILES_PATH=./dados/extracted

# ===================================================================
# DEPLOY VIA DUMP/RESTORE (deploy_dump_prod.py)
# ===================================================================

# Serviço systemd da API — parado/iniciado durante o restore em produção.
# Deixe vazio se não houver API ou se preferir parar manualmente.
# PROD_API_SERVICE=receita-api

# Diretório padrão para dumps locais (scripts/dump_local.sh)
# DUMP_OUTPUT_DIR=./dumps

# Paralelismo do pg_restore no servidor (deploy_dump_prod.py --jobs)
# DUMP_RESTORE_JOBS=4

# ===================================================================
# INSTRUÇÕES DE USO
# ===================================================================

# 1. Copie este arquivo para .env:
#    cp .env.example .env
#
# 2. Edite o arquivo .env com suas configurações
#
# 3. Certifique-se de que o PostgreSQL está rodando:
#    sudo systemctl start postgresql
#
# 4. Crie o banco de dados:
#    createdb -U postgres receita_federal
#
# 5. Execute o ETL:
#    uv run src/etl/ETL_dados_publicos_empresas.py
#
# ===================================================================
# VARIÁVEIS OBRIGATÓRIAS PARA FUNCIONAMENTO
# ===================================================================
#
# As seguintes variáveis são obrigatórias e devem ser configuradas:
# - DB_PASSWORD: Senha do banco PostgreSQL
# - OUTPUT_FILES_PATH: Diretório onde arquivos ZIP serão baixados
# - EXTRACTED_FILES_PATH: Diretório onde arquivos CSV serão extraídos
#
# ===================================================================

